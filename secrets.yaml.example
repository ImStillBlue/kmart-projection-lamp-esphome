# Copy to secrets.yaml and fill in. secrets.yaml is git-ignored.
wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"

# 32-byte base64 key. ESPHome Device Builder generates one for a new device,
# or run: openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_BASE64_KEY"

ota_password: "choose-a-password"

# At least 8 characters
fallback_ap_password: "choose-a-password"
